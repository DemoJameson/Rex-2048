{
  "name": "rex-2048-live-poc",
  "version": "0.3.0",
  "private": true,
  "author": "DemoJameson",
  "type": "module",
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "server": "node server/index.cjs",
    "server:dev": "node --watch server/index.cjs",
    "test": "npm run build && node --test test/*.test.cjs && node test/module-smoke.cjs",
    "test:unit": "node --test test/*.test.cjs",
    "test:module": "node test/module-smoke.cjs",
    "test:stream": "node test/stream-smoke.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "cors": "2.8.5",
    "express": "5.3.0",
    "node-media-server": "4.4.6"
  },
  "devDependencies": {
    "@rexnow/libs": "3.1.3",
    "@rexnow/rslib-plugin": "3.1.3",
    "@rslib/core": "1.0.5",
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
